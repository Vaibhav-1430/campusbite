{
  "name": "campusbite",
  "version": "0.1.0",
  "private": true,
  "description": "CampusBite - Mobile-First Restaurant Order Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@campusbite/shared && npm run build --workspace=@campusbite/api && npm run build --workspace=@campusbite/web",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@campusbite/api",
    "dev:web": "npm run dev --workspace=@campusbite/web",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@campusbite/api",
    "db:deploy": "npm run db:deploy --workspace=@campusbite/api",
    "db:seed:admin": "npm run db:seed:admin --workspace=@campusbite/api"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

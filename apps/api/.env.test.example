# ==============================================================================
# CampusBite — Dedicated Test Environment Configuration (.env.test)
# ==============================================================================
# MANDATORY SAFETY RULES:
# 1. NODE_ENV must ALWAYS be "test".
# 2. DATABASE_URL must target an isolated local or CI test database.
#    - Approved hosts: localhost, 127.0.0.1, postgres (CI container)
#    - Approved DB names: must end with "_test" or "_ci" (e.g. campusbite_test)
# 3. NEVER point this file to Neon, Render, AWS, or any production database!
#    The test runner and Prisma fail closed if a production target is detected.
# ==============================================================================

NODE_ENV=test
PORT=5001

# Isolated Local Test PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusbite_test?schema=public

# Dedicated Test JWT Secret (minimum 32 characters)
JWT_SECRET=campusbite_test_isolated_jwt_secret_entropy_minimum_32_characters

JWT_EXPIRES_IN=1h
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# CampusBite API Server — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure real credentials.
# NEVER commit production .env files to Git.

# ------------------------------------------------------------------------------
# 1. Environment & Network (Mandatory)
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection (Mandatory)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Neon / Supabase: append ?sslmode=require
DATABASE_URL="postgresql://postgres@localhost:5432/campusbite_dev"

# ------------------------------------------------------------------------------
# 3. Security & Token Authentication (Mandatory)
# ------------------------------------------------------------------------------
# In production, this MUST be a cryptographically secure random string with 32+ characters.
# Generate via: openssl rand -hex 32
# Or via Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="campusbite_super_secret_jwt_key_at_least_32_characters_long_for_dev"

# Token validity duration (e.g. 8h, 24h, 7d)
JWT_EXPIRES_IN="8h"

# Cookie Domain:
# Leave empty for localhost or same-domain deployment.
# Set to ".yourdomain.com" if sharing authentication cookies across subdomains.
COOKIE_DOMAIN=""

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Mandatory)
# ------------------------------------------------------------------------------
# Comma-separated list of trusted client URLs allowed to access the API with credentials.
# In production, replace with your live frontend domain (e.g. https://campusbite.vercel.app).
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 5. First-Admin Account Bootstrap (Mandatory for initial setup)
# ------------------------------------------------------------------------------
# Used by 'npm run db:seed:admin' to safely bootstrap the root administrator.
# In production:
# - Set a unique, strong password (at least 12 chars with upper, lower, numbers).
# - Do NOT use default "AdminPassword123!".
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL="admin@campusbite.internal"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"

# ==============================================================================
# CampusBite Web Frontend — Environment Configuration Template
# ==============================================================================

# API Base URL:
# For local dev via Vite proxy: /api/v1 (or left unset)
# For production cross-origin: https://campusbite-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# WebSocket / Socket.IO Server URL:
# For local dev via Vite proxy: http://localhost:5173 (or left unset, defaults to window.location.origin)
# For production cross-origin: https://campusbite-api.onrender.com
VITE_SOCKET_URL=http://localhost:5173
